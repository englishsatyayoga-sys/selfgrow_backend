# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assessment_db?schema=public"

# Authentication & JWT Secrets (at least 32 characters)
JWT_ACCESS_SECRET="your_very_secure_jwt_access_secret_min_32_characters"
JWT_REFRESH_SECRET="your_very_secure_jwt_refresh_secret_min_32_characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Initial Seed Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="AdminSecurePassword123!"

# Razorpay Integration
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_key_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_placeholder_webhook_secret"

# OpenAI Integration
OPENAI_API_KEY="sk-placeholder-openai-key"
OPENAI_MODEL="gpt-4o-mini"
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=60000

# Storage Driver (local | s3)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="assessment-reports"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email Provider (resend | ses | smtp | console)
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@assessment.platform"
APP_PUBLIC_URL="http://localhost:3000"

# Error Monitoring (optional, off by default)
SENTRY_DSN=""
