datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Language {
  EN
  HI
}

enum AssessmentKind {
  OBJECTIVE
  MIXED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TEXT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum ReportStatus {
  QUEUED
  GENERATING
  GENERATED
  PENDING_REVIEW
  RELEASED
  FAILED
  REJECTED
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  passwordHash      String
  role              Role           @default(USER)
  preferredLanguage Language       @default(EN)
  consentAcceptedAt DateTime?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  attempts          Attempt[]
  orders            Order[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Assessment {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            Json
  description      Json
  kind             AssessmentKind
  timeLimitSeconds Int?
  version          Int              @default(1)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  questions        Question[]
  products         Product[]
  attempts         Attempt[]
  reportTemplates  ReportTemplate[]

  @@map("assessments")
}

model Question {
  id           String       @id @default(uuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order        Int
  section      String?
  type         QuestionType
  text         Json
  isRequired   Boolean      @default(true)
  maxLength    Int?
  dimension    String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  options      Option[]
  responses    Response[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@map("questions")
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  label      Json
  score      Int      @default(0)
  isActive   Boolean  @default(true)

  @@unique([questionId, order])
  @@index([questionId])
  @@map("options")
}

model ReportTemplate {
  id                 String     @id @default(uuid())
  name               String
  assessmentId       String
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  version            Int        @default(1)
  isActive           Boolean    @default(true)
  systemPrompt       String     @db.Text
  userPromptTemplate String     @db.Text
  outputSchema       Json
  layout             Json
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  products           Product[]

  @@unique([assessmentId, version])
  @@index([assessmentId])
  @@map("report_templates")
}

model Product {
  id               String          @id @default(uuid())
  slug             String          @unique
  name             Json
  description      Json
  assessmentId     String
  assessment       Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  reportTemplateId String?
  reportTemplate   ReportTemplate? @relation(fields: [reportTemplateId], references: [id], onDelete: SetNull)
  priceInPaise     Int             @default(0)
  currency         String          @default("INR")
  autoRelease      Boolean         @default(true)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  attempts         Attempt[]
  orders           Order[]

  @@index([assessmentId])
  @@index([reportTemplateId])
  @@map("products")
}

model Attempt {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  assessmentId      String
  assessment        Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assessmentVersion Int
  language          Language
  status            AttemptStatus @default(IN_PROGRESS)
  startedAt         DateTime      @default(now())
  expiresAt         DateTime?
  submittedAt       DateTime?
  scoreSummary      Json?
  snapshot          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  responses         Response[]
  order             Order?

  @@index([userId, status])
  @@index([productId])
  @@index([assessmentId])
  @@map("attempts")
}

model Response {
  id                String    @id @default(uuid())
  attemptId         String
  attempt           Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptionIds String[]
  textAnswer        String?
  answeredAt        DateTime  @default(now())
  timeTakenMs       Int?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("responses")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  attemptId       String      @unique
  attempt         Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  amountInPaise   Int
  currency        String      @default("INR")
  status          OrderStatus @default(CREATED)
  razorpayOrderId String?     @unique
  createdAt       DateTime    @default(now())
  paidAt          DateTime?
  payments        Payment[]
  report          Report?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayPaymentId String   @unique
  amountInPaise     Int
  status            String
  method            String?
  failureReason     String?
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@map("payments")
}

model Report {
  id               String           @id @default(uuid())
  orderId          String           @unique
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           ReportStatus     @default(QUEUED)
  language         Language
  content          Json?
  templateVersion  Int
  model            String?
  promptTokens     Int?
  completionTokens Int?
  failureReason    String?
  attemptCount     Int              @default(0)
  generatedAt      DateTime?
  releasedAt       DateTime?
  releasedById     String?
  pdfKey           String?
  pdfGeneratedAt   DateTime?
  emailSentAt      DateTime?
  emailStatus      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  revisions        ReportRevision[]

  @@index([status])
  @@map("reports")
}

model ReportRevision {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  content     Json
  createdAt   DateTime @default(now())
  createdById String?
  reason      String

  @@index([reportId])
  @@map("report_revisions")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@index([provider, eventId])
  @@map("webhook_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
