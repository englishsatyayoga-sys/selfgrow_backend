<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
    <h2 class="section-title" style="margin-bottom: 0;">{{summaryTitle}}</h2>
    {{#if scoreSummary}}
      <span class="score-badge">{{scoreLabel}}: {{scoreSummary.totalScore}} / {{scoreSummary.maxPossibleScore}} ({{scoreSummary.percentage}}%)</span>
    {{/if}}
  </div>
  <p class="section-content">{{executiveSummary}}</p>
</div>

