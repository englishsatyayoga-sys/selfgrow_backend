<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <title>{{assessmentTitle}} - Assessment Report</title>
  <style>
    {{{fontCss}}}

    @page {
      size: A4;
      margin: 15mm 15mm 20mm 15mm;
      @bottom-right {
        content: "Page " counter(page) " of " counter(pages);
        font-family: 'Noto Sans Devanagari', 'Noto Sans', sans-serif;
        font-size: 9pt;
        color: #718096;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Noto Sans Devanagari', 'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #2d3748;
      background-color: #ffffff;
      padding: 10px;
    }

    header {
      border-bottom: 2px solid #4f46e5;
      padding-bottom: 14px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .brand-title {
      font-size: 20pt;
      font-weight: 700;
      color: #1e1b4b;
      margin-bottom: 4px;
    }

    .brand-subtitle {
      font-size: 11pt;
      color: #4f46e5;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .report-meta {
      text-align: right;
      font-size: 9.5pt;
      color: #64748b;
    }

    .card {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 16px 20px;
      margin-bottom: 20px;
      page-break-inside: avoid;
    }

    .section-title {
      font-size: 14pt;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 10px;
      border-left: 4px solid #4f46e5;
      padding-left: 10px;
    }

    .section-content {
      font-size: 10.5pt;
      color: #334155;
      white-space: pre-line;
      margin-bottom: 12px;
    }

    .tag-list {
      list-style-type: none;
      padding-left: 0;
      margin: 8px 0;
    }

    .tag-list li {
      position: relative;
      padding-left: 20px;
      margin-bottom: 6px;
      font-size: 10pt;
      color: #475569;
    }

    .tag-list li::before {
      content: "•";
      color: #4f46e5;
      font-weight: bold;
      font-size: 14pt;
      position: absolute;
      left: 4px;
      top: -3px;
    }

    .score-badge {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 9999px;
      background-color: #e0e7ff;
      color: #3730a3;
      font-weight: 700;
      font-size: 11pt;
    }

    footer {
      margin-top: 30px;
      padding-top: 14px;
      border-top: 1px solid #e2e8f0;
      font-size: 9pt;
      color: #94a3b8;
      text-align: center;
      page-break-inside: avoid;
    }
  </style>
</head>
<body>
  <header>
    <div>
      <div class="brand-title">{{assessmentTitle}}</div>
      <div class="brand-subtitle">{{reportTypeLabel}}</div>
    </div>
    <div class="report-meta">
      <div><strong>{{candidateLabel}}:</strong> {{candidateName}}</div>
      <div><strong>{{dateLabel}}:</strong> {{generatedDate}}</div>
      <div><strong>ID:</strong> {{reportId}}</div>
    </div>
  </header>

  <main>
    {{{bodyContent}}}
  </main>

  <footer>
    <p>{{confidentialityNotice}}</p>
  </footer>
</body>
</html>

